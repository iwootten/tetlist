{
  "name": "tetlist",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    // canonical URLs and the sitemap use the trailing-slash form, so redirect
    // /sets/<slug> to /sets/<slug>/
    "html_handling": "force-trailing-slash"
  },
  "routes": [
    {
      "pattern": "tetlist.com",
      "custom_domain": true
    }
  ]
}
